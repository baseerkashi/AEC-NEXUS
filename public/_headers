# Scoped CSP for the isolated DWG reader worker (LibreDWG embind requires
# dynamic invoker generation inside this one worker document). The main app
# CSP lives in index.html and stays strict - no 'unsafe-eval' there.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' blob: https://developer.api.autodesk.com https://graph.microsoft.com https://*.sharepoint.com https://field.dalux.com https://www.googleapis.com https://generativelanguage.googleapis.com https://api.openai.com https://api.anthropic.com https://api.groq.com https://openrouter.ai https://api.cerebras.ai https://api.deepseek.com https://api.mistral.ai https://api.together.xyz https://api.dropboxapi.com https://content.dropboxapi.com http://localhost:* http://127.0.0.1:* ws://localhost:* wss://localhost:* ws://127.0.0.1:* wss://127.0.0.1:*; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
/assets/dwg-reader-worker-*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'
