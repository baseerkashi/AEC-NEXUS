# ==============================================================================
# AEC NEXUS / Open BIM Studio — Environment Variables
# Copy to .env for local development or paste into Vercel Project Settings.
# ==============================================================================

# --- Frontend (Vite) ---
# Optional: override the backend API base URL (leave empty for same-origin /api)
VITE_API_BASE_URL=

# --- Autodesk Platform Services (APS / Forge) for RVT/NWD/DWG -> IFC ---
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET=openbimstudio-convert

# --- Collaboration & Upload Server Security ---
# Optional Bearer token (minimum 16 chars) to protect /api/* routes
OBS_SERVER_TOKEN=
# Optional comma-separated origin allow-list (e.g. https://your-app.vercel.app)
OBS_ALLOWED_ORIGINS=

# --- Storage & Limits (Optional) ---
# Data directory (defaults to /tmp/openbimstudio-data automatically on Vercel)
OBS_DATA_DIR=
# Max request body in bytes (note: Vercel Serverless Functions cap bodies at 4.5 MB)
OBS_MAX_BODY=
